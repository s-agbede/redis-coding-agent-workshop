# Copy to .env and fill in. Works with any OpenAI-compatible endpoint.
AGENT_API_KEY=sk-...
# Optional: override for Azure / a proxy / a local model server.
# AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5

# Browser workshop. Set 0.0.0.0 for network access behind authentication.
WORKSHOP_PORT=8080
WORKSHOP_BIND_ADDRESS=0.0.0.0

# Memory workshop: preprovisioned Iris services (Python SDKs installed with --group iris).
# AGENT_MEMORY_URL=https://your-region.memory.redis.io
# AGENT_MEMORY_STORE_ID=...
# AGENT_MEMORY_API_KEY=...
# PLAYBOOK_DATA_PLANE_URL=https://your-playbook-endpoint
# PLAYBOOK_PLAYBOOK_ID=...
# PLAYBOOK_API_KEY=...  # attendees: read access; instructor: create, publish and read
# Attendees: the instructor-published skill entry ID (printed by the instructor's /publish-skill).
# PLAYBOOK_SKILL_ID=...
# For a host-local Playbook used from Docker:
# WORKSHOP_PLAYBOOK_DATA_PLANE_URL=http://host.docker.internal:9301
# Optional stable synthetic learner identity; otherwise persisted in output/workshop.
# IRIS_OWNER_ID=learner-example
