# Copy to .env and fill in. Works with any OpenAI-compatible endpoint.
AGENT_API_KEY=sk-...
# Optional: override for Azure / a proxy / a local model server.
# AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5

# Browser workshop. Set 0.0.0.0 for network access behind authentication.
WORKSHOP_PORT=8080
WORKSHOP_BIND_ADDRESS=0.0.0.0

# Memory workshop: preprovisioned Iris services (Python SDKs installed with --group iris).
# Use the GA endpoint and st_ store ID from the Redis Cloud connection dialog.
# AGENT_MEMORY_URL=https://your-agent-memory-endpoint
# AGENT_MEMORY_STORE_ID=...
# AGENT_MEMORY_API_KEY=...
# PLAYBOOK_DATA_PLANE_URL=https://your-playbook-endpoint
# PLAYBOOK_PLAYBOOK_ID=...
# PLAYBOOK_API_KEY=...  # Attendee labs: read-only. Keep the instructor publishing key separate.
# Optional instructor-published skill entry ID; listing and retrieval work without it.
# PLAYBOOK_SKILL_ID=...
# For a host-local Playbook used from Docker:
# WORKSHOP_PLAYBOOK_DATA_PLANE_URL=http://host.docker.internal:9301
# Optional stable synthetic learner identity; otherwise generated and persisted per workspace.
# Leave unset in a shared lab template; never reuse one identity across attendees.
# IRIS_OWNER_ID=learner-example

# Redis Insight (http://localhost:8080/redisinsight/) databases. scripts/workbench_with_iris_preview.sh
# fills these in for the Iris preview; set them yourself for other Redis databases.
# INSIGHT_DB1_HOST=host.docker.internal
# INSIGHT_DB1_PORT=16480
# INSIGHT_DB1_ALIAS=...
# INSIGHT_DB1_PASSWORD=...
# (and INSIGHT_DB2_*)

# Slash-command completion uses the workshop's own Redis (started by start.sh, on localhost:6390).
# REDIS_URL=redis://localhost:6390/0

# Legacy Memory 0.7 settings: incompatible with the current GA 1.1 SDK; migrate the service before use.
# AGENT_MEMORY_LICENSE_FILE=/absolute/path/to/agent-memory.license
# COMPOSE_FILE=docker-compose.yml:docker-compose.selfhost.yml
# AGENT_MEMORY_MODEL=gpt-4o-mini
